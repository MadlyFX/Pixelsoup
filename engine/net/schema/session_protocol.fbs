namespace mediaserver.net.protocol_fb.v1;

struct Id128 {
  high:ulong;
  low:ulong;
}

struct StreamCursor {
  through_frame:ulong;
  revision:ulong;
  next_command_id:ulong;
}

struct SessionLimits {
  max_packet_bytes:ulong;
  max_frame_bytes:ulong;
  max_inflight_frames:uint;
  max_inflight_bytes:ulong;
  max_checkpoint_bytes:ulong;
}

enum ResumeMode:ubyte {
  NONE = 0,
  UpToDate = 1,
  Replay = 2,
  Checkpoint = 3
}

enum RejectCode:ushort {
  NONE = 0,
  UnsupportedVersion = 1,
  ShowMismatch = 2,
  InvalidCursor = 3,
  ResumeUnavailable = 4,
  CapacityExceeded = 5,
  ProtocolError = 6,
  ServerShutdown = 7,
  NodeLeaseRejected = 8
}

enum GoodbyeReason:ubyte {
  NONE = 0,
  NormalShutdown = 1,
  Restart = 2,
  Maintenance = 3,
  SessionReplaced = 4
}

table Packet {
  bytes:[ubyte] (required);
}

table ClientHello {
  min_version:ushort;
  max_version:ushort;
  show_id:Id128 (required);
  node_id:Id128 (required);
  incarnation:Id128 (required);
  // Exact render/output selector used by the process. This is distinct from
  // node_id: the latter is the durable session lease identity, while this
  // value binds the live session to an authored Hardware Map output.
  node_index:uint;
  last_director_epoch:Id128 (required);
  cursor:StreamCursor (required);
  force_checkpoint:bool;
  limits:SessionLimits (required);
}

table ServerWelcome {
  selected_version:ushort;
  show_id:Id128 (required);
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  mode:ResumeMode;
  accepted_from:StreamCursor (required);
  target:StreamCursor (required);
  limits:SessionLimits (required);
}

table FrameBatch {
  session_id:Id128 (required);
  sequence:ulong;
  before:StreamCursor (required);
  after:StreamCursor (required);
  packets:[Packet] (required);
}

table CheckpointTransfer {
  session_id:Id128 (required);
  sequence:ulong;
  cursor:StreamCursor (required);
  wire_packet:[ubyte] (required);
}

table SyncComplete {
  session_id:Id128 (required);
  sequence:ulong;
  target:StreamCursor (required);
}

table ResumeAck {
  session_id:Id128 (required);
  sequence:ulong;
  target:StreamCursor (required);
}

table Reject {
  code:RejectCode;
  show_id:Id128 (required);
  director_epoch:Id128 (required);
  authoritative_tail:StreamCursor (required);
}

// Sent by a node after it has validated and staged a complete FrameBatch, but
// before that frame becomes visible. acknowledged_sequence identifies the
// Director-to-node FrameBatch; sequence belongs to the monotonic
// node-to-Director control stream (ResumeAck is 1, so its first frame
// acknowledgement is 2).
table FramePrepared {
  session_id:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  after:StreamCursor (required);
}

// Sent by a node after the staged frame has been committed at its show-clock
// boundary. The identifiers have the same meaning as in FramePrepared.
table FrameCommitted {
  session_id:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  after:StreamCursor (required);
}

// Sent by the Director after the software barrier has durably released the
// referenced FrameBatch for visibility. Both sequence and acknowledged_sequence
// belong to the Director-to-node stream; barrier_ordinal identifies the durable
// release decision independently of transport sequencing.
table FrameCommitPermit {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  barrier_ordinal:ulong;
  before:StreamCursor (required);
  after:StreamCursor (required);
}

// One tracked camera pose, sampled once by the Director at a frame boundary
// and associated with the exact 64-bit show frame it applies to.
//
// It belongs on the per-frame path rather than in Heartbeat because it must be
// exactly aligned to a show frame, not merely recent. It is deliberately not a
// document command: a pose written into the document would bump the document
// version every frame, and document version is the temporal-history epoch.
//
// Position is metres in stage space. Orientation and field of view are turns.
// Latency compensation is already applied: control_frame is the frame this pose
// is *for*, not the frame it was sampled on.
//
// The control frame rather than the show frame, deliberately. A parked timeline
// stops advancing the show frame, and that is exactly when an operator is
// lining up a shot and most wants the wall to track; the control frame is the
// replication clock the frame barrier already holds nodes together on.
table TrackedCameraSample {
  // The authored camera node this pose drives. A stage runs several cameras and
  // each has its own feed, so a sample is meaningless without saying whose.
  camera_node:ulong;
  position_x:float;
  position_y:float;
  position_z:float;
  yaw_turns:float;
  pitch_turns:float;
  roll_turns:float;
  field_of_view_turns:float;
  aspect_ratio:float;
  // Monotonic tracker ordinal, for diagnostics. Never used to order frames.
  tracker_sequence:ulong;
  // Which physical camera on the stage produced it.
  camera_id:uint;
  // Source-native lens controls carried beside the pose. Zero is a valid
  // encoder position, so presence is explicit rather than inferred from it.
  zoom_encoder:float;
  focus_encoder:float;
  iris_encoder:float;
  zoom_encoder_valid:bool;
  focus_encoder_valid:bool;
  iris_encoder_valid:bool;
  focal_length_mm:float;
  focus_distance_m:float;
  aperture_f_number:float;
}

// Every tracked camera's pose for one control frame, in one message.
//
// One message rather than one per camera, because the whole stack has to land
// together: a node that applied camera A's new pose and camera B's previous one
// would composite two moments into a single frame, and its neighbour might
// split them the other way.
// pose_sequence numbers the Director's pose stream itself, and it is the only
// field a node can detect a dropped pose with. `sequence` cannot do it: that
// consumes the Director outbound stream and is assigned when a message is
// sent, so a pose that was overwritten in a session's mailbox before it was
// ever sent leaves no gap there. pose_sequence is assigned once when the pose
// is published to every session, so a node that receives 7 then 9 knows it
// never saw 8 and that its plate is one sample staler than its neighbour's.
table TrackedCameraPose {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  pose_sequence:ulong;
  control_frame:ulong;
  samples:[TrackedCameraSample];
}

// Director-to-node liveness probe. sequence consumes the Director outbound
// stream. released_through is the contiguous durably released cursor, never
// merely the WAL tail. response_timeout_ms is in the inclusive range
// 250..120000 and is measured after receipt of the complete message.
table Heartbeat {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  response_timeout_ms:uint;
  released_through:StreamCursor (required);
  conformance_request:ulong;
}

// Node-to-Director response to one outstanding Heartbeat. sequence consumes
// the node control stream; acknowledged_sequence identifies the Heartbeat in
// the opposite-direction stream. visible_through is diagnostic progress, not
// release authority.
enum RuntimeBarrierState:ubyte {
  Unknown = 0,
  Unsupported = 1,
  NotJoined = 2,
  Joining = 3,
  Joined = 4,
  Left = 5,
  Failed = 6
}

enum RuntimeReferenceClockState:ubyte {
  Unknown = 0,
  Unsupported = 1,
  Waiting = 2,
  Locked = 3,
  Lost = 4,
  Failed = 5
}

enum RuntimeMediaDecodeState:ubyte {
  Unknown = 0,
  HardwareAccelerated = 1,
  SoftwareOnly = 2,
  Unavailable = 3
}

enum RuntimeProxyState:ubyte {
  Source = 0,
  ProxyReady = 1,
  PreferFallback = 2,
  RequiredUnready = 3,
  Failed = 4
}

enum RuntimeRendererBackend:ubyte {
  Unknown = 0,
  Basic = 1,
  Advanced = 2
}

enum RuntimeRendererReadinessState:ubyte {
  Unknown = 0,
  Ready = 1,
  BasicFallback = 2,
  MissingCapabilities = 3,
  AdvancedImplementationUnavailable = 4,
  InvalidPolicy = 5
}

table RuntimeMediaAssetStatus {
  asset_id:ulong;
  decode:RuntimeMediaDecodeState;
  proxy_state:RuntimeProxyState;
  // Numeric values are the frozen RuntimeProxyReason and RuntimeProxyIssue
  // vocabularies in session_protocol.hpp.
  proxy_reason:ubyte;
  proxy_issue:ubyte;
  has_transcode_progress:bool;
  transcode_queued:bool;
  transcode_completed_frames:ulong;
  transcode_total_frames:ulong;
}

table RenderConformance {
  state:ubyte;
  version:uint;
  request:ulong;
  adapter_name:string;
  driver_version:ulong;
  vendor:uint;
  device:uint;
  shader_bundle:[ubyte];
  passes:[ulong];
  failed_pass:ubyte = 20;
  strict_float:bool;
}

table FrameTiming {
  sequence:ulong; profile_digest:ulong; cpu_record_ns:ulong; gpu_ns:ulong;
  upload_bytes:ulong; present_ns:ulong; presents:ulong; presents_in_sync:ulong;
  flips_in_sync:ulong; query_overflows:ulong; pass_ns:[ulong]; gpu_valid:bool;
}

table HeartbeatAck {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  visible_through:StreamCursor (required);
  // Runtime-only acknowledgement that this process has installed the exact
  // verified asset overlay identified by asset_manifest_digest. False is an
  // explicit unresolved/missing/faulted state, not merely an old report.
  asset_manifest_digest:ulong;
  asset_manifest_ready:bool;
  // Physical presentation state only the render process can observe: whether
  // its swapchains joined the expected vendor present barrier, and how the
  // frames it presented actually landed. Genlock aligns raster boundaries;
  // these fields are what say whether every output advanced from image N to
  // image N+1 together. Unknown is the honest default and never means locked.
  output_sync_state:RuntimeBarrierState;
  output_sync_group:uint;
  output_sync_barrier:uint;
  output_sync_joined_outputs:uint;
  output_sync_expected_outputs:uint;
  presented_frames:ulong;
  missed_frames:ulong;
  late_frames:ulong;
  held_frames:ulong;
  repeated_frames:ulong;
  loss_of_sync_events:ulong;
  // Bounded to max_runtime_media_assets by the session codec. The manifest
  // digest binds every entry to the exact replicated AssetRegistry revision.
  media_assets:[RuntimeMediaAssetStatus];
  // Last renderer policy actually observed by this process's Program path.
  // A zero digest is Unknown; the Director compares nonzero values with the
  // exact currently authored profile before accepting the selection.
  renderer_profile_digest:ulong;
  renderer_state:RuntimeRendererReadinessState;
  renderer_requested:RuntimeRendererBackend;
  renderer_selected:RuntimeRendererBackend;
  renderer_missing_capabilities:ulong;
  renderer_satisfied:bool;
  renderer_fallback:bool;
  renderer_asset_digest:ulong;
  renderer_assets_ready:bool;
  renderer_asset_visible_commit:ulong;
  // Appended so an older peer sees an honest Unknown/default report. These
  // are driver facts, not local presentation estimates.
  barrier_presents:ulong;
  barrier_presents_in_sync:ulong;
  barrier_flips_in_sync:ulong;
  reference_clock:RuntimeReferenceClockState;
  reference_frame_counter:uint;
  // What this node is doing with the poses it was sent, and with the plate it
  // was asked to draw. Appended, so an older peer reports honest zeroes.
  //
  // Until this existed a node said nothing at all about tracking: the Director
  // could see that it had sent poses and nothing about whether they arrived,
  // whether this node was holding a stale one, or whether it drew a plate. A
  // wall that is a sample behind its neighbour looks identical to one that is
  // not, from every surface an operator has.
  tracking_pose_sequence:ulong;
  tracking_poses_missed:ulong;
  tracking_poses_applied:ulong;
  tracking_held_frames:ulong;
  tracking_plates_drawn:ulong;
  tracking_plates_skipped:ulong;
  tracking_plate_refusals:ulong;
  tracking_poses_coalesced:ulong;
  renderer_temporal_restarts:ulong;
  renderer_temporal_restart_frame:ulong;
  renderer_conformance:RenderConformance;
  renderer_timing:FrameTiming;
}

// Bidirectional graceful-close notice. final_cursor is only the sender's safe
// externally visible frontier and cannot advance the peer's authoritative
// state.
table Goodbye {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  reason:GoodbyeReason;
  final_cursor:StreamCursor (required);
}

union SessionBody {
  ClientHello = 1,
  ServerWelcome = 2,
  FrameBatch = 3,
  CheckpointTransfer = 4,
  SyncComplete = 5,
  ResumeAck = 6,
  Reject = 7,
  FramePrepared = 8,
  FrameCommitted = 9,
  FrameCommitPermit = 10,
  Heartbeat = 11,
  HeartbeatAck = 12,
  Goodbye = 13,
  TrackedCameraPose = 14
}

table SessionEnvelope {
  format_version:ushort;
  body:SessionBody (required);
}

root_type SessionEnvelope;
file_identifier "MSNP";
file_extension "msnp";
