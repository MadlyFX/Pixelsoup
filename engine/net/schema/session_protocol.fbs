namespace mediaserver.net.protocol_fb.v1;

struct Id128 {
  high:ulong;
  low:ulong;
}

struct StreamCursor {
  through_frame:ulong;
  revision:ulong;
  next_command_id:ulong;
}

struct SessionLimits {
  max_packet_bytes:ulong;
  max_frame_bytes:ulong;
  max_inflight_frames:uint;
  max_inflight_bytes:ulong;
  max_checkpoint_bytes:ulong;
}

enum ResumeMode:ubyte {
  NONE = 0,
  UpToDate = 1,
  Replay = 2,
  Checkpoint = 3
}

enum RejectCode:ushort {
  NONE = 0,
  UnsupportedVersion = 1,
  ShowMismatch = 2,
  InvalidCursor = 3,
  ResumeUnavailable = 4,
  CapacityExceeded = 5,
  ProtocolError = 6,
  ServerShutdown = 7,
  NodeLeaseRejected = 8
}

enum GoodbyeReason:ubyte {
  NONE = 0,
  NormalShutdown = 1,
  Restart = 2,
  Maintenance = 3,
  SessionReplaced = 4
}

table Packet {
  bytes:[ubyte] (required);
}

table ClientHello {
  min_version:ushort;
  max_version:ushort;
  show_id:Id128 (required);
  node_id:Id128 (required);
  incarnation:Id128 (required);
  // Exact render/output selector used by the process. This is distinct from
  // node_id: the latter is the durable session lease identity, while this
  // value binds the live session to an authored Hardware Map output.
  node_index:uint;
  last_director_epoch:Id128 (required);
  cursor:StreamCursor (required);
  force_checkpoint:bool;
  limits:SessionLimits (required);
}

table ServerWelcome {
  selected_version:ushort;
  show_id:Id128 (required);
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  mode:ResumeMode;
  accepted_from:StreamCursor (required);
  target:StreamCursor (required);
  limits:SessionLimits (required);
}

table FrameBatch {
  session_id:Id128 (required);
  sequence:ulong;
  before:StreamCursor (required);
  after:StreamCursor (required);
  packets:[Packet] (required);
}

table CheckpointTransfer {
  session_id:Id128 (required);
  sequence:ulong;
  cursor:StreamCursor (required);
  wire_packet:[ubyte] (required);
}

table SyncComplete {
  session_id:Id128 (required);
  sequence:ulong;
  target:StreamCursor (required);
}

table ResumeAck {
  session_id:Id128 (required);
  sequence:ulong;
  target:StreamCursor (required);
}

table Reject {
  code:RejectCode;
  show_id:Id128 (required);
  director_epoch:Id128 (required);
  authoritative_tail:StreamCursor (required);
}

// Sent by a node after it has validated and staged a complete FrameBatch, but
// before that frame becomes visible. acknowledged_sequence identifies the
// Director-to-node FrameBatch; sequence belongs to the monotonic
// node-to-Director control stream (ResumeAck is 1, so its first frame
// acknowledgement is 2).
table FramePrepared {
  session_id:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  after:StreamCursor (required);
}

// Sent by a node after the staged frame has been committed at its show-clock
// boundary. The identifiers have the same meaning as in FramePrepared.
table FrameCommitted {
  session_id:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  after:StreamCursor (required);
}

// Sent by the Director after the software barrier has durably released the
// referenced FrameBatch for visibility. Both sequence and acknowledged_sequence
// belong to the Director-to-node stream; barrier_ordinal identifies the durable
// release decision independently of transport sequencing.
table FrameCommitPermit {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  barrier_ordinal:ulong;
  before:StreamCursor (required);
  after:StreamCursor (required);
}

// Director-to-node liveness probe. sequence consumes the Director outbound
// stream. released_through is the contiguous durably released cursor, never
// merely the WAL tail. response_timeout_ms is in the inclusive range
// 250..120000 and is measured after receipt of the complete message.
table Heartbeat {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  response_timeout_ms:uint;
  released_through:StreamCursor (required);
}

// Node-to-Director response to one outstanding Heartbeat. sequence consumes
// the node control stream; acknowledged_sequence identifies the Heartbeat in
// the opposite-direction stream. visible_through is diagnostic progress, not
// release authority.
enum RuntimeBarrierState:ubyte {
  Unknown = 0,
  Unsupported = 1,
  NotJoined = 2,
  Joining = 3,
  Joined = 4,
  Left = 5,
  Failed = 6
}

enum RuntimeMediaDecodeState:ubyte {
  Unknown = 0,
  HardwareAccelerated = 1,
  SoftwareOnly = 2,
  Unavailable = 3
}

enum RuntimeProxyState:ubyte {
  Source = 0,
  ProxyReady = 1,
  PreferFallback = 2,
  RequiredUnready = 3,
  Failed = 4
}

table RuntimeMediaAssetStatus {
  asset_id:ulong;
  decode:RuntimeMediaDecodeState;
  proxy_state:RuntimeProxyState;
  // Numeric values are the frozen RuntimeProxyReason and RuntimeProxyIssue
  // vocabularies in session_protocol.hpp.
  proxy_reason:ubyte;
  proxy_issue:ubyte;
  has_transcode_progress:bool;
  transcode_queued:bool;
  transcode_completed_frames:ulong;
  transcode_total_frames:ulong;
}

table HeartbeatAck {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  acknowledged_sequence:ulong;
  visible_through:StreamCursor (required);
  // Runtime-only acknowledgement that this process has installed the exact
  // verified asset overlay identified by asset_manifest_digest. False is an
  // explicit unresolved/missing/faulted state, not merely an old report.
  asset_manifest_digest:ulong;
  asset_manifest_ready:bool;
  // Physical presentation state only the render process can observe: whether
  // its swapchains joined the expected vendor present barrier, and how the
  // frames it presented actually landed. Genlock aligns raster boundaries;
  // these fields are what say whether every output advanced from image N to
  // image N+1 together. Unknown is the honest default and never means locked.
  output_sync_state:RuntimeBarrierState;
  output_sync_group:uint;
  output_sync_barrier:uint;
  output_sync_joined_outputs:uint;
  output_sync_expected_outputs:uint;
  presented_frames:ulong;
  missed_frames:ulong;
  late_frames:ulong;
  held_frames:ulong;
  repeated_frames:ulong;
  loss_of_sync_events:ulong;
  // Bounded to max_runtime_media_assets by the session codec. The manifest
  // digest binds every entry to the exact replicated AssetRegistry revision.
  media_assets:[RuntimeMediaAssetStatus];
}

// Bidirectional graceful-close notice. final_cursor is only the sender's safe
// externally visible frontier and cannot advance the peer's authoritative
// state.
table Goodbye {
  session_id:Id128 (required);
  director_epoch:Id128 (required);
  sequence:ulong;
  reason:GoodbyeReason;
  final_cursor:StreamCursor (required);
}

union SessionBody {
  ClientHello = 1,
  ServerWelcome = 2,
  FrameBatch = 3,
  CheckpointTransfer = 4,
  SyncComplete = 5,
  ResumeAck = 6,
  Reject = 7,
  FramePrepared = 8,
  FrameCommitted = 9,
  FrameCommitPermit = 10,
  Heartbeat = 11,
  HeartbeatAck = 12,
  Goodbye = 13
}

table SessionEnvelope {
  format_version:ushort;
  body:SessionBody (required);
}

root_type SessionEnvelope;
file_identifier "MSNP";
file_extension "msnp";
