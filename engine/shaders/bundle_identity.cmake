# Hash actual binary outputs, with stable relative names and the FP contract.
# This runs in the build, never while recording or starting a show.
include("${INPUTS}")
if(STRICT)
    set(strict_bool true)
else()
    set(strict_bool false)
endif()
set(identity "mediaserver-shaders-v1;sm=6.2;denorm=preserve;strict=${strict_bool}\n")
foreach(binary IN LISTS BUNDLE_INPUTS)
    get_filename_component(name "${binary}" NAME)
    file(SHA256 "${binary}" digest)
    string(APPEND identity "${name}:${digest}\n")
endforeach()
string(SHA256 bundle "${identity}")
set(bytes "")
foreach(index RANGE 0 31)
    math(EXPR offset "${index} * 2")
    string(SUBSTRING "${bundle}" ${offset} 2 byte)
    string(APPEND bytes "0x${byte},")
endforeach()
file(WRITE "${OUTPUT}.tmp" "#pragma once\n#include <array>\n#include <cstdint>\nnamespace mediaserver::shaders {\ninline constexpr std::array<std::uint8_t,32> bundle_sha256{${bytes}};\ninline constexpr bool strict_float=${strict_bool};\n}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
