namespace mediaserver.wire.fb.v1;

table BoolProperty {
  value:bool;
}

table Int64Property {
  value:long;
}

table Float64Property {
  value:double;
}

table StringProperty {
  value:string (required);
}

union PropertyPayload {
  BoolProperty = 1,
  Int64Property = 2,
  Float64Property = 3,
  StringProperty = 4
}

table Property {
  name:string (required, key);
  value:PropertyPayload (required);
}

table Node {
  id:ulong (key);
  node_type:string (required);
  properties:[Property] (required);
}

table PutNode {
  node:Node (required);
}

table EraseNode {
  node_id:ulong;
}

union Payload {
  PutNode = 1,
  EraseNode = 2
}

table Command {
  id:ulong;
  base_revision:ulong;
  result_revision:ulong;
  apply_at_frame:ulong;
  transaction_id:ulong;
  undo_context_id:ulong;
  forward:Payload (required);
  inverse:Payload (required);
}

table SealedCommand {
  id:ulong;
  fingerprint:ulong;
}

table FrameSeal {
  frame:ulong;
  base_revision:ulong;
  result_revision:ulong;
  commands:[SealedCommand] (required);
}

table StreamCursor {
  through_frame:ulong;
  revision:ulong;
  next_command_id:ulong;
}

table DocumentSnapshot {
  cursor:StreamCursor (required);
  nodes:[Node] (required);
}

union EnvelopeBody {
  Command = 1,
  FrameSeal = 2,
  StreamCursor = 3,
  DocumentSnapshot = 4
}

table Envelope {
  format_version:ushort;
  body:EnvelopeBody (required);
}

root_type Envelope;
file_identifier "MSWP";
file_extension "mswp";
