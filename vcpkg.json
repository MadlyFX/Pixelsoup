{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "media-server",
  "version-string": "0.1.0",
  "description": "Cross-platform virtual production media server",
  "builtin-baseline": "3af1d1e60af2b2abf55760538cd607829029b07a",
  "dependencies": [
    "asio",
    "flatbuffers"
  ],
  "features": {
    "gui": {
      "description": "SDL3 window output for the Director preview and node output shells. Optional so a headless node never links a video subsystem.",
      "dependencies": [
        "sdl3",
        "stb",
        "openexr",
        "opencolorio",
        "cgltf",
        "mikktspace",
        "tinyobjloader",
        "tinyfiledialogs",
        {
          "name": "ffmpeg",
          "features": [
            "nvcodec"
          ]
        },
        "freetype"
      ]
    },
    "studio": {
      "description": "Additional GUI dependencies for the ajfx Studio application.",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "sdl3-binding",
            "freetype"
          ]
        },
        "imguizmo"
      ]
    }
  },
  "overrides": [
    {
      "name": "asio",
      "version": "1.32.0",
      "port-version": 0
    },
    {
      "name": "flatbuffers",
      "version": "25.9.23",
      "port-version": 1
    },
    {
      "name": "sdl3",
      "version": "3.2.26",
      "port-version": 0
    }
  ]
}
