# Blender writes the previous save beside a .blend; Git already keeps history.
*.blend1
*.blend

# Derived import/lighting packages are recreated from their source assets.
.mslink-cache-v1/
*.gltf.*.msmodel
*.glb.*.msmodel
*.obj.*.msmodel
*.fbx.*.msmodel
/scripts/lighting.*.msgi

# Python caches are disposable regardless of which working directory runs them.
__pycache__/
*.py[cod]
# Local driving footage: too large for Git without LFS.
/Models
