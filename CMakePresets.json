{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "development",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "MEDIASERVER_BUILD_SERVER": "ON",
        "MEDIASERVER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Run from an MSVC developer shell with Ninja on PATH.",
      "inherits": "development",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug + sanitizers",
      "inherits": "development",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "MEDIASERVER_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug-gui",
      "displayName": "Windows MSVC Debug + SDL3 window shell",
      "description": "Adds the optional SDL3 output shell. Run from an MSVC developer shell with Ninja on PATH.",
      "inherits": "windows-msvc-debug",
      "cacheVariables": {
        "MEDIASERVER_ENABLE_GUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    },
    {
      "name": "windows-msvc-release-gui",
      "displayName": "Windows MSVC Release + SDL3 operator/output shell",
      "description": "Optimized portable Windows build. Run from an MSVC developer shell with Ninja and VCPKG_ROOT configured.",
      "inherits": "development",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "MEDIASERVER_ENABLE_GUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    },
    {
      "name": "macos-clang-debug-gui",
      "displayName": "macOS Clang Debug + SDL3 output shell",
      "description": "Build the cross-platform operator/output shell with Apple Clang and SDL3.",
      "inherits": "development",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "MEDIASERVER_ENABLE_GUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "gui"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "windows-msvc-debug-gui",
      "configurePreset": "windows-msvc-debug-gui"
    },
    {
      "name": "windows-msvc-release-gui",
      "configurePreset": "windows-msvc-release-gui"
    },
    {
      "name": "macos-clang-debug-gui",
      "configurePreset": "macos-clang-debug-gui"
    },
    {
      "name": "area-spine",
      "displayName": "Debug GUI: spine tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-spine"
      ]
    },
    {
      "name": "area-session",
      "displayName": "Debug GUI: session tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-session"
      ]
    },
    {
      "name": "area-persist",
      "displayName": "Debug GUI: persist tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-persist"
      ]
    },
    {
      "name": "area-scene",
      "displayName": "Debug GUI: scene tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-scene"
      ]
    },
    {
      "name": "area-compositor",
      "displayName": "Debug GUI: compositor tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-compositor"
      ]
    },
    {
      "name": "area-particles",
      "displayName": "Debug GUI: particle tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-particles"
      ]
    },
    {
      "name": "area-output",
      "displayName": "Debug GUI: output tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-output"
      ]
    },
    {
      "name": "area-render",
      "displayName": "Debug GUI: render tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-render"
      ]
    },
    {
      "name": "area-editor",
      "displayName": "Debug GUI: editor tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-editor"
      ]
    },
    {
      "name": "area-server",
      "displayName": "Debug GUI: server tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-server"
      ]
    },
    {
      "name": "area-blender",
      "displayName": "Debug GUI: blender tests only",
      "configurePreset": "windows-msvc-debug-gui",
      "targets": [
        "tests-blender"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "windows-msvc-debug-gui",
      "configurePreset": "windows-msvc-debug-gui",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "windows-msvc-release-gui",
      "configurePreset": "windows-msvc-release-gui",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "macos-clang-debug-gui",
      "configurePreset": "macos-clang-debug-gui",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "quick",
      "displayName": "Debug GUI: everything except slow tests",
      "description": "Day-to-day pass after a full Debug GUI build. Skips entries labelled slow (and the opt-in soak).",
      "configurePreset": "windows-msvc-debug-gui",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "^(slow|soak)$"
        }
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "area-spine",
      "displayName": "Debug GUI: spine tests",
      "description": "Run after cmake --build --preset area-spine.",
      "configurePreset": "windows-msvc-debug-gui",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^spine$"
        }
      },
      "execution": {
        "jobs": 8
      }
    },
    {
      "name": "area-session",
      "displayName": "Debug GUI: session tests",
